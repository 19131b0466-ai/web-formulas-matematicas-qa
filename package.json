{
  "name": "web-formulas-matematicas",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,json,md}\"",
    "db:generate": "pnpm --filter @repo/api db:generate",
    "db:migrate": "pnpm --filter @repo/api db:migrate",
    "db:studio": "pnpm --filter @repo/api db:studio",
    "db:seed": "pnpm --filter @repo/api db:seed",
    "test": "turbo test",
    "gsc:priority": "node scripts/gsc-prioritize.mjs",
    "seo:cwv-audit": "node scripts/cwv-audit.mjs",
    "seo:sitemap-audit": "node scripts/seo-sitemap-audit.mjs",
    "qa:calculo-diferencial": "pnpm --filter @repo/content-parser build && node scripts/verify-calculo-diferencial.mjs",
    "qa:fisica-electronica": "pnpm --filter @repo/shared-types build && pnpm --filter @repo/content-parser build && node scripts/verify-fisica-electronica.mjs",
    "docs:calculo-diferencial-rutas": "pnpm --filter @repo/content-parser build && node scripts/generate-calculo-diferencial-rutas-revision.mjs"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@9.15.1",
  "engines": {
    "node": ">=22"
  }
}

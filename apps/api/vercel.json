{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "hono",
  "installCommand": "cd ../.. && pnpm install",
  "buildCommand": "cd ../.. && pnpm --filter @repo/api... build",
  "crons": [
    {
      "path": "/v1/health",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/v1/cron/purge-visits",
      "schedule": "0 4 * * 0"
    }
  ]
}

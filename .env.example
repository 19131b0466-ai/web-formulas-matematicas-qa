# PostgreSQL local (docker-compose)
DATABASE_URL=postgresql://formulas:formulas_dev@localhost:5432/formulas_db

# Producción (Supabase): usa el pooler en transaction mode, puerto 6543
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# API (local dev)
PORT=3001
CORS_ORIGINS=http://localhost:3000,http://localhost:3002
JWT_SECRET=dev-only-change-me-in-production

# Local admin credentials (used when Supabase Auth is not configured)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme

# Vercel Cron (API project) — required in production
CRON_SECRET=

# Frontends
NEXT_PUBLIC_API_URL=http://localhost:3001/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Auth (production / optional locally)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
